# ── Server Config ───────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://127.0.0.1:8002

# ── Database ──────────────────────────────────────────────────
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=loukarver
 
# ── JWT Secrets ───────────────────────────────────────────────
SECRET_KEY=your_secret_key_here
REFRESH_SECRET_KEY=your_refresh_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=12000
REFRESH_TOKEN_EXPIRE_DAYS=30
 
# ── Email / SMTP ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@yourdomain.com
 
# ── Youtube crediential ───────────────────────────────────────
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/music/youtube/callback
YOUTUBE_API_KEY=your_youtube_api_key
 
#---------One Signal---------------------
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# ── AWS S3 & CloudFront Configuration ────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_CLOUDFRONT_DOMAIN=your_cloudfront_domain.cloudfront.net

