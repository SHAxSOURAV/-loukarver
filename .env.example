# ── App Config ──────────────────────────────────────────────────
# Port for Expo Metro bundler & Web
PORT=4002

# ── Backend API Base URL ────────────────────────────────────────
# For Local Development (physical mobile device on same WiFi):
# EXPO_PUBLIC_BACKEND_URL=http://<YOUR_LOCAL_IP>:8000
# For Production / ngrok Tunnel:
EXPO_PUBLIC_BACKEND_URL=https://your-production-url.com

# ── OneSignal Push Notifications ────────────────────────────────
EXPO_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id
