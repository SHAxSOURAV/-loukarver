{
  "expo": {
    "owner": "learnwithmotaleb",
    "name": "Samesy",
    "slug": "aligned-rn",
    "scheme": "samesy",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F4EEE4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.loukarver.app",
      "buildNumber": "5",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Samesy to access your camera to take photos and scan pairing QR codes.",
        "NSPhotoLibraryUsageDescription": "Allow Samesy to access your photo library for profile photos and shared memories.",
        "NSMicrophoneUsageDescription": "Allow Samesy to access your microphone for voice notes.",
        "NSLocationWhenInUseUsageDescription": "Allow Samesy to access your location to show your accurate local time and city to your partner.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Allow Samesy to save photos and memories to your photo library.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "versionCode": 5,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#F4EEE4"
      },
      "package": "com.loukarver.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Samesy to access your location to show your accurate local time and city to your partner."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Samesy to save photos to your device.",
          "savePhotosPermission": "Allow Samesy to save photos to your device.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Samesy to access your microphone for voice notes."
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.loukarver.app.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.loukarver.app.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "5cc6de43-554a-4b95-bf1d-fdec2274812d"
      }
    }
  }
}
